# Copy to .env and fill in. NEVER commit .env.
REAL_A_API_KEY=
REAL_A_ENDPOINT=https://api.deepseek.com/v1/chat/completions
POLYGATE_API_KEYS=
# Dedicated server-side Web identity. When auth is enabled, include this value
# in POLYGATE_API_KEYS; never prefix it with VITE_ or expose it to the browser.
WEB_GATEWAY_API_KEY=
# Gateway reliability defaults. Keep the request budgets larger than a single
# provider attempt so retries/failover have room to complete.
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_STREAM_IDLE_TIMEOUT_SECONDS=90
GATEWAY_NON_STREAM_BUDGET_SECONDS=30
GATEWAY_STREAM_START_BUDGET_SECONDS=30
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.2
PROVIDER_RETRY_MAX_BACKOFF_SECONDS=5
# Authenticated Decision Records are redacted and expire from Redis after this TTL.
DECISION_RECORD_TTL_SECONDS=3600
