{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PolyGate Decision Record v1",
  "description": "Short-lived, authenticated and redacted final routing result returned by GET /v1/decisions/{request_id}.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "outcome",
    "chosen_provider",
    "initial_provider",
    "reason",
    "cache_hit",
    "stream",
    "cost_estimate_usd",
    "latency_ms",
    "tokens",
    "retries",
    "failover_from",
    "failover_count",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{32}$"
    },
    "outcome": {
      "enum": ["success", "cache_hit", "cancelled", "partial_error"]
    },
    "chosen_provider": { "type": "string", "minLength": 1 },
    "initial_provider": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "cache_hit": { "type": "boolean" },
    "stream": { "type": "boolean" },
    "cost_estimate_usd": { "type": "number", "minimum": 0 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 }
      }
    },
    "retries": { "type": "integer", "minimum": 0 },
    "failover_from": { "type": ["string", "null"] },
    "failover_count": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
