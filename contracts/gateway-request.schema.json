{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://polygate.example/contracts/gateway-request.schema.json",
  "title": "PolyGate Gateway Request v2",
  "description": "Agent-capable OpenAI Chat Completions request with PolyGate routing constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "messages"],
  "properties": {
    "model": { "type": "string", "minLength": 1 },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/message" }
    },
    "tools": {
      "type": "array",
      "items": { "type": "object" }
    },
    "tool_choice": {
      "oneOf": [
        { "type": "string", "enum": ["none", "auto", "required"] },
        { "type": "object" }
      ]
    },
    "parallel_tool_calls": { "type": "boolean" },
    "temperature": { "type": "number" },
    "top_p": { "type": "number" },
    "max_tokens": { "type": "integer", "minimum": 1 },
    "max_completion_tokens": { "type": "integer", "minimum": 1 },
    "stop": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "response_format": { "type": "object" },
    "stream": { "type": "boolean", "default": false },
    "stream_options": { "type": "object" },
    "seed": { "type": "integer" },
    "frequency_penalty": { "type": "number" },
    "presence_penalty": { "type": "number" },
    "logit_bias": { "type": "object", "additionalProperties": { "type": "number" } },
    "logprobs": { "type": "boolean" },
    "top_logprobs": { "type": "integer" },
    "user": { "type": "string" },
    "service_tier": { "type": "string" },
    "reasoning_effort": { "type": "string" },
    "store": { "type": "boolean" },
    "polygate": { "$ref": "#/definitions/polygate" }
  },
  "definitions": {
    "contentBlock": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "type": "string" } },
      "additionalProperties": true
    },
    "message": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["system", "developer", "user", "assistant", "tool"]
        },
        "content": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/definitions/contentBlock" } }
          ]
        },
        "name": { "type": "string" },
        "tool_calls": { "type": "array", "items": { "type": "object" } },
        "tool_call_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "polygate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latency_target_ms": { "type": "integer", "minimum": 1, "default": 3000 },
        "max_cost_usd": { "type": "number", "minimum": 0, "default": 0.01 },
        "privacy": { "type": "string", "enum": ["standard", "high"], "default": "standard" },
        "quality": { "type": "string", "enum": ["balanced", "high", "cheap"], "default": "balanced" },
        "cache_control": { "type": "string", "enum": ["auto", "no-store"], "default": "auto" },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
