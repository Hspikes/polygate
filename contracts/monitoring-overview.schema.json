{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PolyGate Monitoring Overview",
  "description": "Monitoring API response consumed by the monitoring frontend.",
  "type": "object",
  "required": [
    "generated_at",
    "window",
    "gateway",
    "cache",
    "usage",
    "providers",
    "resources",
    "partial",
    "warnings"
  ],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "window": { "type": "string", "enum": ["5m", "15m", "1h", "6h"] },
    "gateway": {
      "type": "object",
      "required": ["requests_total", "requests_per_second", "error_rate", "p95_latency_ms"],
      "properties": {
        "requests_total": { "type": "integer", "minimum": 0 },
        "requests_per_second": { "type": "number", "minimum": 0 },
        "error_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "p95_latency_ms": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "cache": {
      "type": "object",
      "required": ["lookups_total", "hit_rate"],
      "properties": {
        "lookups_total": { "type": "integer", "minimum": 0 },
        "hit_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "estimated_cost_usd"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "requests", "success_rate", "p95_latency_ms"],
        "properties": {
          "name": { "type": "string" },
          "requests": { "type": "integer", "minimum": 0 },
          "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
          "p95_latency_ms": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "available",
        "cpu_cores",
        "memory_bytes",
        "current_replicas",
        "desired_replicas"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "cpu_cores": { "type": ["number", "null"], "minimum": 0 },
        "memory_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "current_replicas": { "type": ["integer", "null"], "minimum": 0 },
        "desired_replicas": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "partial": { "type": "boolean" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
